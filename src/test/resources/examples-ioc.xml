<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- 用户Repository -->
    <bean id="userRepository" class="com.minispring.examples.IoCBasicExample$UserRepository"/>

    <!-- 用户Service - 演示依赖注入 -->
    <bean id="userService" class="com.minispring.examples.IoCBasicExample$UserService">
        <property name="appName" value="Mini-Spring应用"/>
        <property name="userRepository" ref="userRepository"/>
    </bean>

</beans>
